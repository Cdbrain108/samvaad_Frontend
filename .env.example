# Firebase Authentication & Firestore Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Gateway URL (Optional, defaults to local proxy)
VITE_API_BASE_URL=http://localhost:8000

# Oracle Cloud CPU VM Inference Endpoint (Optional)
VITE_ORACLE_GURU_URL=https://your-oracle-domain.example.com
VITE_ORACLE_API_KEY=your_oracle_secret_key

# High-Speed LLM Inference API Keys (Comma-separated)
VITE_GROQ_API_KEYS=gsk_key1,gsk_key2
VITE_NVIDIA_API_KEY=nvapi_your_key_here
