  "unindexed_do_not_route": {
    "note": "Named in concept_taxonomy.json target_scriptures but with NO file in rag_scriptures/corpus/by_scripture, therefore no Qdrant collection. Deliberately absent from the maps above: the gateway's anti-contamination rule returns EMPTY for a scripture filter that matches no collection, so routing to one of these would silently destroy grounding.",
    "ids": ["katha_upanishad", "taittiriya_upanishad", "yoga_vasistha", "narada_bhakti_sutra", "manusmriti"]
  },

  "known_collection_hazards": {
    "samaveda": "The stem 'samaveda' also substring-matches the collection scripture_samaveda_corrupt_backup. aws_rag_gateway.py filters out any collection ending in _corrupt_backup before querying.",
    "bhagavata": "Never use the bare stem 'bhagavata' as a filter: it matches BOTH scripture_bhagavata_purana and scripture_devi_bhagavata. Always use the full ids."
  }
