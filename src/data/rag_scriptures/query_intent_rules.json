{
  "version": "1.0.0",
  "description": "Shared query-intent rules for Samvaad. Single source of truth for verse-count intent and exact scripture routing, consumed by BOTH rag_engine/query_intent.py (backend) and frontend/src/services/scriptureService.js. Keep the two pipelines aligned by editing ONLY this file.",

  "policy": {
    "default_verse_count": 1,
    "max_verse_count": 8,
    "note": "Multi-verse is STRICTLY OPT-IN. verse_count > 1 only when the seeker explicitly asks for a number of verses, or uses an unambiguous plural-ask phrase from explicit_multi_phrases. Every other query keeps the single-primary-verse satsang behaviour."
  },

  "countable_nouns": [
    "question", "questions", "verse", "verses", "shlok", "shloka", "shlokas", "shloks",
    "sloka", "slokas", "mantra", "mantras", "quote", "quotes", "reference", "references",
    "example", "examples", "teaching", "teachings", "point", "points",
    "prashn", "prashna", "prashan", "sawal", "shlokon", "doha", "dohe",
    "प्रश्न", "प्रश्नों", "श्लोक", "श्लोकों", "सवाल", "मंत्र", "मन्त्र",
    "दोहा", "दोहे", "सन्दर्भ", "संदर्भ", "उदाहरण", "बातें", "वाक्य", "शिक्षा"
  ],

  "number_words": {
    "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7, "eight": 8,
    "ek": 1, "do": 2, "teen": 3, "char": 4, "chaar": 4, "paanch": 5, "panch": 5,
    "chhah": 6, "chhe": 6, "saat": 7, "aath": 8,
    "१": 1, "२": 2, "३": 3, "४": 4, "५": 5, "६": 6, "७": 7, "८": 8,
    "एक": 1, "दो": 2, "तीन": 3, "चार": 4, "पाँच": 5, "पांच": 5,
    "छह": 6, "छः": 6, "सात": 7, "आठ": 8
  },

  "explicit_multi_phrases": [
    "multiple verses", "multiple shlok", "multiple shloka", "multiple quotes", "multiple references",
    "several verses", "several shlok", "several quotes", "a few verses", "a few shlok",
    "list of verses", "list the verses", "list some verses", "list of shlok", "list some shlok",
    "many verses", "many shlok", "more than one verse", "more verses", "some verses", "some shlokas",
    "kuch shlok", "kai shlok", "kayi shlok", "bahut se shlok", "sare shlok", "saare shlok",
    "कुछ श्लोक", "कई श्लोक", "अनेक श्लोक", "सभी श्लोक", "बहुत से श्लोक",
    "कुछ प्रश्न", "कई प्रश्न", "कुछ संदर्भ", "कुछ सन्दर्भ"
  ],

